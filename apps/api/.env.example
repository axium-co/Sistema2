# Aplicação
NODE_ENV=development
PORT=3333
# URL do front (usada em convites/links). Em produção, domínio da Vercel.
WEB_URL=http://localhost:3000
# Origens liberadas no CORS, separadas por vírgula (obrigatória em produção).
# Ex.: https://meu-app.vercel.app,https://app.meudominio.com
CORS_ORIGIN="http://localhost:3000"
# Validação de DTO: campos não declarados são descartados (whitelist).
# "true" passa a rejeitar campos extras (400) em vez de ignorá-los.
VALIDATION_STRICT=false

# Banco de dados / cache
DATABASE_URL="postgresql://axium:axium_dev_password@localhost:5433/axium?schema=public"
# Obrigatória em produção (pub/sub das notificações em tempo real).
REDIS_URL="redis://localhost:6379"

# JWT (gere segredos fortes e distintos em produção; a API falha se faltar um dos dois
# ou se um deles for "dev-jwt-secret-change-me")
JWT_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# Armazenamento (local | s3)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="axium-files"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_FORCE_PATH_STYLE=true

# Segurança de arquivos (heurística local; false desliga o bloqueio)
FILE_SCAN_ENABLED=true
# Antivírus (clamd via INSTREAM). Sem CLAMAV_HOST usa apenas a heurística local.
CLAMAV_HOST=""
CLAMAV_PORT=3310
# true bloqueia o arquivo quando o clamd está configurado mas indisponível
CLAMAV_STRICT=false
# Tamanho das partes do upload resumível (MB)
UPLOAD_CHUNK_SIZE_MB=5

# E-mail (convites). Sem SMTP_HOST opera em modo console (log).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="AXIUM <nao-responder@axium.local>"

# Row Level Security no banco (ver prisma/rls-enforce.sql). Off por padrão.
RLS_ENABLED=false

# Billing (Asaas). Sem ASAAS_API_KEY a cobrança roda em modo simulado.
ASAAS_API_KEY=""
ASAAS_BASE_URL="https://api.asaas.com/v3"
ASAAS_WEBHOOK_TOKEN=""

# API pública (/api/v1). Limite de requisições por minuto por chave.
API_RATE_LIMIT_PER_MIN=120

# Google Calendar (OAuth). Sem credenciais opera em modo simulado.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Padrão: {API_PUBLIC_URL|http://localhost:PORT}/api/integrations/google/callback
API_PUBLIC_URL=""
GOOGLE_REDIRECT_URI=""
